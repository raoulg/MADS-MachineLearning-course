{
  "mcpServers": {
    "vectormesh": {
      "command": "sh",
      "args": [
        "-c",
        "uv run --no-project https://raw.githubusercontent.com/raoulg/vectormesh/$VECTORMESH_REF/vectormesh_mcp.py"
      ],
      "env": {
        "VECTORMESH_REF": "stable"
      }
    },
    "codestyle": {
      "command": "sh",
      "args": [
        "-c",
        "uv run --no-project https://raw.githubusercontent.com/raoulg/codestyle/$CODESTYLE_REF/codestyle_mcp.py"
      ],
      "env": {
        "CODESTYLE_REF": "stable"
      }
    }
  }
}
